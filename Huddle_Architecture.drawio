        <mxCell id="e7" value="peer_store" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="policy" target="peer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="ACK-retained queue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="policy" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Retry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1" edge="1" parent="1" source="sender" target="online"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="peer" target="receive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="relay" target="receive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="receive" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="security" name="5 - Security Boundaries">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Security and Data Boundaries" style="text;html=1;align=center;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="450" y="30" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="client" value="CLIENT DEVICE&#xa;&#xa;May hold: own private keys, authorized plaintext, encrypted history, manifests, protocol state&#xa;&#xa;Must not hold: other devices' private keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="140" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="server" value="FIREBASE CONTROL PLANE + TYPESCRIPT API&#xa;&#xa;May observe: accounts, public keys, membership, roles, revocation, IPs, timing, presence, authorized transient SDP/ICE, provider-gated ciphertext queue&#xa;&#xa;Must never obtain: private keys, plaintext messages, reusable content keys, SDP/ICE logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="140" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="relay" value="TURN / FORWARDER / TTL QUEUE&#xa;&#xa;May observe: endpoints, routing, timing, sizes, ciphertext&#xa;&#xa;Must never obtain: plaintext or content-decryption keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1120" y="140" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="peer" value="OTHER HUDDLE PEERS&#xa;&#xa;May observe: direct IP address unless privacy relay is forced, authorized messages, timing&#xa;&#xa;Cannot be forced to erase data already received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="340" y="520" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="owner" value="HUDDLE OWNER / MODERATOR&#xa;&#xa;Controls: admission, roles, removals, signed offline policy&#xa;&#xa;Cannot: decrypt arbitrary device history or recover lost device keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="520" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="e1" value="Authenticated public metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="client" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Application-encrypted traffic" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="client" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Non-content test events now; authenticated E2EE only after provider approval" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="client" target="peer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Signed manifest changes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" edge="1" parent="1" source="owner" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Security claim: the design minimizes central plaintext exposure; it does not provide metadata anonymity, guaranteed direct transport, perfect deletion, or protection from a compromised endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="350" y="830" width="900" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
