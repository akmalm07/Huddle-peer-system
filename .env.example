# Copy to .env for local development. Do not commit .env.
# Firebase project configuration is public client configuration; credentials and
# Admin SDK secrets belong only in the deployment environment.
FIREBASE_PROJECT_ID=huddle-demo
HUDDLE_AUTH_PORT=4001
HUDDLE_SIGNALING_PORT=4002
# Keep local development loopback-only. Docker Compose overrides this to expose
# the signaling health boundary through the mapped container port.
HUDDLE_BIND_HOST=127.0.0.1
HUDDLE_ALLOWED_ORIGIN=http://localhost:5173
# JSON array of public STUN/TURN endpoints. Never place static TURN passwords
# here; the future authorization API mints short-lived credentials.
HUDDLE_ICE_SERVERS=[]

# Always disabled unless an explicit, reviewed test enables it.
EXPERIMENTAL_DEVICE_FALLBACK=false
