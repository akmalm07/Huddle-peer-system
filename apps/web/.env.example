# Public Firebase web configuration. These values identify the Firebase app;
# they are not an Admin credential.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
# Use the Firebase Hosting origin. The Hosting rewrite routes /v1/** to Cloud
# Run, keeping passkey traffic same-origin.
VITE_AUTH_API_ORIGIN=http://localhost:4001
# Optional public STUN URLs as a JSON array. TURN credentials come from auth.
VITE_STUN_URLS=[]
