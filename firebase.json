{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "hosting": {
    "site": "test-96102",
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/healthz",
        "run": {
          "serviceId": "huddle-auth",
          "region": "us-east4"
        }
      },
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "huddle-auth",
          "region": "us-east4"
        }
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "database": { "port": 9000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
